#!/usr/bin/env sh
# Aborts any commit whose message smuggles in a Cursor / agent / tool footer.
# Wired via `git config core.hooksPath .githooks` (see README local setup).

msg_file="$1"

PATTERN='^Co-authored-by:[[:space:]]*Cursor([[:space:]]|<)|^Co-authored-by:.*cursoragent@cursor\.com'

if grep -E -i "$PATTERN" "$msg_file" >/dev/null 2>&1; then
  echo "commit-msg hook: refused to commit." >&2
  echo "  Reason: message contains an automated agent co-author trailer." >&2
  echo "  Offending lines:" >&2
  grep -E -i -n "$PATTERN" "$msg_file" >&2
  echo "  Strip it from your commit message and try again." >&2
  exit 1
fi

exit 0
