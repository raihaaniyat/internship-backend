# =====================================================================
# Local development environment for the Bun monorepo.
# Copy to `.env` (it is gitignored) before running anything.
# Do NOT commit `.env`.
# =====================================================================

# ---- Database (used by docker-compose and both apps) ----------------
POSTGRES_USER=internship
POSTGRES_PASSWORD=internship_dev_password
POSTGRES_DB=internship
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Drizzle / postgres-js connection string. Both apps and migrations read this.
DATABASE_URL=postgres://internship:internship_dev_password@localhost:5432/internship

# ---- Better Auth ----------------------------------------------------
# Long random string. Generate with: openssl rand -base64 32
# Both apps/auth and apps/api MUST share the same value so that
# bearer tokens issued by apps/auth can be verified by apps/api.
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated list of origins allowed to talk to apps/auth.
# In production this MUST be your real frontend origin, never `*`.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Ports ----------------------------------------------------------
AUTH_PORT=3001
API_PORT=3000

# ---- apps/api -------------------------------------------------------
# Origins allowed to call the API in the browser. Same production rule.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Seed (optional) ------------------------------------------------
# Used by `bun run db:seed` to create test users via Better Auth.
SEED_ADMIN_EMAIL=admin@buyanyautopart.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_USER_EMAIL=user@buyanyautopart.com
SEED_USER_PASSWORD=User1234!
